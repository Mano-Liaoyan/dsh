{
  "upstream": {
    "url": "https://github.com/deepseek-ai/deepseek-harness.git",
    "branch": "master"
  },
  "fork": [
    ".github/fork/**",
    ".github/workflows/fork-*.yml",
    "FORK.md"
  ],
  "extensions": [
    "extensions/**"
  ],
  "docs": {
    "include": [
      "**/*.md",
      "**/*.i18n.yaml",
      "docs/**",
      "website/**/*.md",
      ".agents/skills/**",
      ".agents/notes/**"
    ],
    "exclude": [
      "**/*.expected.md",
      "**/expected/**",
      "**/tests/**",
      "snapshots/**"
    ]
  },
  "baseline": [
    "apps/web/tests/expected/models-settings/catalog-inputs.expected.md",
