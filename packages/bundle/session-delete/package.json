{
  "name": "@deepseek-ai/dsh-session-delete-bundle",
  "version": "0.2.1-rc.3",
  "description": "Opt-in confirmed session deletion through the GUI and agent tools, with shutdown of running work.",
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/bundle/session-delete"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts", "locale/*.json", "cordis.patch.yml"],
  "license": "MIT",
  "dsh": { "bundle": { "patch": "./cordis.patch.yml", "listedByDefault": false } },
  "dependencies": {
    "@deepseek-ai/dsh-session-delete": "workspace:*",
    "@deepseek-ai/dsh-client-ui-session-delete": "workspace:*"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "workspace:~" },
  "devDependencies": { "@deepseek-ai/cordis": "workspace:~" }
}
